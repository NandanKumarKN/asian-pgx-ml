# ── Raw data (too large for Git — download via download_data.py) ──
data/raw/1kgp/
data/raw/gtex/
data/raw/pharmgkb/
*.vcf
*.vcf.gz
*.bam
*.bai
*.gz
*.tbi

# ── Processed data (reproducible from raw — don't commit) ──
data/processed/

# ── Model files (large — store separately if needed) ──
results/models/*.pkl
results/models/*.joblib

# ── Python ──
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.env
.venv
venv/
env/

# ── Jupyter ──
.ipynb_checkpoints/
*.ipynb_checkpoints

# ── IDE ──
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# ── Conda ──
.conda/

